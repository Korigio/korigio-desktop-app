{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:path:default",
    "core:webview:allow-print",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "mailto:info@korigio.com*" },
        { "url": "https://github.com/Korigio/korigio-downloads/*" },
        { "url": "https://korigio.github.io/korigio-downloads/*" }
      ]
    }
  ]
}
